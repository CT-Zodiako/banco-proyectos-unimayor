# OS and editor
.DS_Store
.vscode/

# Dependencies, builds and caches
node_modules/
dist/
__pycache__/
*.log

# Secrets
.env
.env.*

# Local backups (e.g. the empty Git repository the project bank came with)
.backup/

# banco-proyectos: temporary DOCX extraction folders
apps/banco-proyectos/temp_docx_extract*/

# donde-publicar: DOAJ download (the weekly workflow downloads it again). The SCImago CSV in
# pipelines/donde-publicar/data/raw/scimago/ is versioned: SCImago blocks scripted downloads, so it is replaced by hand yearly.
pipelines/donde-publicar/data/raw/doaj/

# eventos: cached downloads of the public sources (regenerate with python3 -E -m pipeline.build)
pipelines/eventos/data/raw/
